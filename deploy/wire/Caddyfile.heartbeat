# Import this handler inside the existing api.seiche.info site block, before
# that site's catch-all handler. It creates no new hostname or TLS dependency.
route /narcoscope/wire-heartbeat-v1.json {
	@narcoscope_wire_heartbeat_get_or_head method GET HEAD

	handle @narcoscope_wire_heartbeat_get_or_head {
		root * /var/lib/narcoscope-wire-public
		header {
			Cache-Control "no-store"
			Content-Security-Policy "default-src 'none'; frame-ancestors 'none'"
			X-Content-Type-Options "nosniff"
		}
		file_server
	}

	handle {
		header Allow "GET, HEAD"
		header Cache-Control "no-store"
		header X-Content-Type-Options "nosniff"
		respond "method not allowed" 405
	}
}
