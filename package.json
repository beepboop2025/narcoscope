{
  "name": "narcoscope",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run news:check && tsc --noEmit && vite build",
    "start": "node server.mjs",
    "preview": "vite preview",
    "scrape:myanmar": "node scripts/scrape/myanmar-conflict-precursors.mjs",
    "bridge:palimpsest": "node scripts/bridge/build-palimpsest-china.mjs && node scripts/bridge/build-palimpsest-corridors.mjs && node scripts/bridge/build-palimpsest-bri.mjs",
    "bridge:palimpsest-bri:check": "node scripts/bridge/build-palimpsest-bri.mjs --check",
    "news:build": "node scripts/newsroom/build-newsroom.mjs",
    "news:check": "node scripts/newsroom/build-newsroom.mjs --check",
    "data:refresh": "node scripts/pipeline/run.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "ontology": "node scripts/ontology/derive-ontology.mjs",
    "data:overdose": "node scripts/convert/cdc-overdose-to-json.mjs",
    "data:designations": "node scripts/convert/ofac-designations-to-json.mjs",
    "data:wastewater": "node scripts/convert/statcan-wastewater-to-json.mjs",
    "private:import:scamshield": "node scripts/private/import-scamshield-summary.mjs"
  },
  "dependencies": {
    "@react-spring/web": "^9.7.5",
    "@react-three/drei": "^9.122.0",
    "@react-three/fiber": "^8.18.0",
    "@react-three/postprocessing": "^2.19.1",
    "d3-geo": "^3.1.1",
    "lenis": "^1.3.23",
    "postprocessing": "^6.39.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^3.9.1",
    "three": "^0.168.0",
    "topojson-client": "^3.1.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/d3-geo": "^3.1.0",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/topojson-client": "^3.1.5",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/coverage-v8": "^4.1.9",
    "happy-dom": "^20.11.2",
    "pdfjs-dist": "^4.10.38",
    "railway": "3.11.0",
    "typescript": "^6.0.3",
    "vite": "^8.1.3",
    "vitest": "^4.1.9"
  }
}
